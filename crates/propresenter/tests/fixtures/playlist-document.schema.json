{
  "$defs": {
    "ArrangementChoice": {
      "description": "The arrangement an item selects.",
      "oneOf": [
        {
          "description": "No arrangement selected; the presentation plays in its own cue order.",
          "properties": {
            "choice": {
              "const": "presentation_default",
              "type": "string"
            }
          },
          "required": [
            "choice"
          ],
          "type": "object"
        },
        {
          "description": "A specific arrangement of the presentation.",
          "properties": {
            "choice": {
              "const": "selected",
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/NativeId",
              "description": "Arrangement identifier inside the presentation."
            },
            "name": {
              "description": "Arrangement name recorded on the item (may be empty in the file).",
              "type": "string"
            }
          },
          "required": [
            "choice",
            "id",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "ArrangementSummary": {
      "description": "An arrangement: an ordered selection of cue groups.",
      "properties": {
        "groups": {
          "description": "Cue group names in play order (a group may repeat).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Arrangement identifier, when recorded."
        },
        "name": {
          "description": "Arrangement name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "groups"
      ],
      "type": "object"
    },
    "CueGroupSummary": {
      "description": "A cue group and its slides.",
      "properties": {
        "labels": {
          "description": "Distinct slide labels in the group, in slide order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Group name.",
          "type": "string"
        },
        "slide_count": {
          "description": "Number of slides in the group.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "slide_count",
        "labels"
      ],
      "type": "object"
    },
    "DocumentSource": {
      "description": "Where a document's playlist data came from.",
      "oneOf": [
        {
          "description": "An exported `.proplaylist` package; presentations are its embedded files.",
          "properties": {
            "file_name": {
              "description": "File name of the package.",
              "type": "string"
            },
            "kind": {
              "const": "package",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file_name"
          ],
          "type": "object"
        },
        {
          "description": "The live `Playlists/Library` document of a `ProPresenter` data root;\npresentations are read from the library files it links to.",
          "properties": {
            "kind": {
              "const": "live_library",
              "type": "string"
            },
            "selected": {
              "description": "Name of the playlist (or folder) that was selected.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selected"
          ],
          "type": "object"
        }
      ]
    },
    "ItemProblem": {
      "description": "A disagreement between a playlist item and its presentation.",
      "oneOf": [
        {
          "description": "The item selects an arrangement the presentation does not define.",
          "properties": {
            "id": {
              "$ref": "#/$defs/NativeId",
              "description": "The selected arrangement identifier."
            },
            "problem": {
              "const": "arrangement_not_in_presentation",
              "type": "string"
            }
          },
          "required": [
            "problem",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "NativeId": {
      "description": "A UUID exactly as the native file stores it (uppercase, hyphenated).\n\nNative identifiers are volatile across rewrites of a playlist; use them to\ncorrelate within one document, not across documents.",
      "type": "string"
    },
    "NumberRange": {
      "description": "Inclusive integer range.",
      "properties": {
        "end": {
          "description": "Last value.",
          "format": "int32",
          "type": "integer"
        },
        "start": {
          "description": "First value.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Playlist": {
      "description": "One playlist: an ordered list of items.",
      "properties": {
        "folders": {
          "description": "Names of the folders enclosing the playlist, outermost first, excluding\nthe unnamed root.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native playlist identifier, when the file records one."
        },
        "items": {
          "description": "Items in operator order.",
          "items": {
            "$ref": "#/$defs/PlaylistItem"
          },
          "type": "array"
        },
        "name": {
          "description": "Operator-visible playlist name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "folders",
        "items"
      ],
      "type": "object"
    },
    "PlaylistItem": {
      "description": "One entry in a playlist.",
      "oneOf": [
        {
          "$ref": "#/$defs/PresentationItem",
          "description": "A presentation (slides) the operator can trigger.",
          "properties": {
            "kind": {
              "const": "presentation",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A section header; its name is the heading text.",
          "properties": {
            "kind": {
              "const": "header",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A single cue stored directly in the playlist.",
          "properties": {
            "kind": {
              "const": "cue",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An item linked to a Planning Center plan item.",
          "properties": {
            "kind": {
              "const": "planning_center",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A placeholder for content that is not yet attached.",
          "properties": {
            "kind": {
              "const": "placeholder",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The file records no item type.",
          "properties": {
            "kind": {
              "const": "untyped",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "hidden": {
          "description": "Whether the operator has hidden the item.",
          "type": "boolean"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native item identifier, when the file records one."
        },
        "index": {
          "description": "Zero-based position within its playlist.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Operator-visible item name (may differ from the presentation's name).",
          "type": "string"
        }
      },
      "required": [
        "index",
        "name",
        "hidden"
      ],
      "type": "object"
    },
    "PresentationContent": {
      "description": "What could be read from a linked presentation.",
      "oneOf": [
        {
          "$ref": "#/$defs/PresentationSummary",
          "description": "The presentation was read.",
          "properties": {
            "status": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "The presentation could not be read; no content is known.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/UnavailableReason",
              "description": "Why it could not be read."
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationItem": {
      "description": "A presentation item: its source file, arrangement and content summary.",
      "properties": {
        "arrangement": {
          "$ref": "#/$defs/ArrangementChoice",
          "description": "Which arrangement the item plays."
        },
        "content": {
          "$ref": "#/$defs/PresentationContent",
          "description": "What was found in the presentation, or why nothing could be read."
        },
        "problems": {
          "description": "Disagreements between the item and the presentation it links to.",
          "items": {
            "$ref": "#/$defs/ItemProblem"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/PresentationLocator",
          "description": "The file the item links to."
        }
      },
      "required": [
        "source",
        "arrangement",
        "content",
        "problems"
      ],
      "type": "object"
    },
    "PresentationLocator": {
      "description": "How a presentation item locates its file, as recorded in the playlist.",
      "oneOf": [
        {
          "description": "Path relative to the `ProPresenter` data root (for example\n`Libraries/Default/Song.pro`).",
          "properties": {
            "locator": {
              "const": "show_relative",
              "type": "string"
            },
            "path": {
              "description": "The relative path.",
              "type": "string"
            }
          },
          "required": [
            "locator",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Path relative to a user folder (home, documents, ...) rather than the\ndata root.",
          "properties": {
            "locator": {
              "const": "other_relative",
              "type": "string"
            },
            "path": {
              "description": "The relative path.",
              "type": "string"
            }
          },
          "required": [
            "locator",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Absolute path or `file://` URL on the machine that wrote the playlist.",
          "properties": {
            "locator": {
              "const": "absolute",
              "type": "string"
            },
            "path": {
              "description": "The decoded absolute path.",
              "type": "string"
            }
          },
          "required": [
            "locator",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Path on an external volume.",
          "properties": {
            "locator": {
              "const": "external",
              "type": "string"
            },
            "path": {
              "description": "The path.",
              "type": "string"
            }
          },
          "required": [
            "locator",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "The item records no file location.",
          "properties": {
            "locator": {
              "const": "unspecified",
              "type": "string"
            }
          },
          "required": [
            "locator"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationReferenceDiagnostic": {
      "description": "A malformed or ambiguous native presentation reference.",
      "oneOf": [
        {
          "description": "More than one cue owns the same UUID.",
          "properties": {
            "cue_indexes": {
              "description": "Every raw cue index carrying the UUID.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "duplicate_cue_uuid",
              "type": "string"
            },
            "uuid": {
              "description": "Duplicated UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uuid",
            "cue_indexes"
          ],
          "type": "object"
        },
        {
          "description": "More than one cue group owns the same UUID.",
          "properties": {
            "cue_group_indexes": {
              "description": "Every raw cue-group index carrying the UUID.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "duplicate_cue_group_uuid",
              "type": "string"
            },
            "uuid": {
              "description": "Duplicated UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uuid",
            "cue_group_indexes"
          ],
          "type": "object"
        },
        {
          "description": "More than one arrangement owns the same UUID.",
          "properties": {
            "arrangement_indexes": {
              "description": "Every raw arrangement index carrying the UUID.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "duplicate_arrangement_uuid",
              "type": "string"
            },
            "uuid": {
              "description": "Duplicated UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uuid",
            "arrangement_indexes"
          ],
          "type": "object"
        },
        {
          "description": "The selected arrangement UUID does not resolve to an arrangement.",
          "properties": {
            "kind": {
              "const": "dangling_selected_arrangement",
              "type": "string"
            },
            "uuid": {
              "description": "Unresolved selected-arrangement UUID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uuid"
          ],
          "type": "object"
        },
        {
          "description": "The selected arrangement UUID resolves to multiple arrangements.",
          "properties": {
            "arrangement_indexes": {
              "description": "Every matching raw arrangement index.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "ambiguous_selected_arrangement",
              "type": "string"
            },
            "uuid": {
              "description": "Ambiguous selected-arrangement UUID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "uuid",
            "arrangement_indexes"
          ],
          "type": "object"
        },
        {
          "description": "A cue-group reference does not resolve to a cue.",
          "properties": {
            "cue_group_index": {
              "description": "Raw cue-group index containing the reference.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "dangling_cue_reference",
              "type": "string"
            },
            "reference_index": {
              "description": "Reference position inside the cue group.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "uuid": {
              "description": "Unresolved UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cue_group_index",
            "reference_index",
            "uuid"
          ],
          "type": "object"
        },
        {
          "description": "A cue-group reference resolves to multiple cues.",
          "properties": {
            "cue_group_index": {
              "description": "Raw cue-group index containing the reference.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "cue_indexes": {
              "description": "Every matching raw cue index.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "ambiguous_cue_reference",
              "type": "string"
            },
            "reference_index": {
              "description": "Reference position inside the cue group.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "uuid": {
              "description": "Ambiguous UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cue_group_index",
            "reference_index",
            "uuid",
            "cue_indexes"
          ],
          "type": "object"
        },
        {
          "description": "An arrangement reference does not resolve to a cue group.",
          "properties": {
            "arrangement_index": {
              "description": "Raw arrangement index containing the reference.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "dangling_group_reference",
              "type": "string"
            },
            "reference_index": {
              "description": "Reference position inside the arrangement.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "uuid": {
              "description": "Unresolved UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "arrangement_index",
            "reference_index",
            "uuid"
          ],
          "type": "object"
        },
        {
          "description": "An arrangement reference resolves to multiple cue groups.",
          "properties": {
            "arrangement_index": {
              "description": "Raw arrangement index containing the reference.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "cue_group_indexes": {
              "description": "Every matching raw cue-group index.",
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "ambiguous_group_reference",
              "type": "string"
            },
            "reference_index": {
              "description": "Reference position inside the arrangement.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "uuid": {
              "description": "Ambiguous UUID value.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "arrangement_index",
            "reference_index",
            "uuid",
            "cue_group_indexes"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationSummary": {
      "description": "Compact content summary of one presentation. Slide text, styling and\nlayout are deliberately not included.",
      "properties": {
        "arrangements": {
          "description": "Arrangements the presentation defines.",
          "items": {
            "$ref": "#/$defs/ArrangementSummary"
          },
          "type": "array"
        },
        "cue_groups": {
          "description": "Cue groups (for example Verse 1, Chorus) in file order.",
          "items": {
            "$ref": "#/$defs/CueGroupSummary"
          },
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Presentation identifier, when recorded."
        },
        "media": {
          "description": "File names of background media used by the slides, first use first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Presentation name stored in the file.",
          "type": "string"
        },
        "scripture": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptureReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Scripture metadata attached to the presentation, when present."
        },
        "slide_count": {
          "description": "Number of slides (cues).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "structure_problems": {
          "description": "Broken or ambiguous internal references found in the presentation.",
          "items": {
            "$ref": "#/$defs/PresentationReferenceDiagnostic"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "slide_count",
        "cue_groups",
        "arrangements",
        "media",
        "structure_problems"
      ],
      "type": "object"
    },
    "SchemaVersion": {
      "const": 1,
      "description": "Playlist document schema version. Always the constant shown here.",
      "type": "integer"
    },
    "ScriptureReference": {
      "description": "Scripture metadata of a presentation.",
      "properties": {
        "book": {
          "description": "Book name as shown to the operator.",
          "type": "string"
        },
        "chapters": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumberRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive chapter range, when recorded."
        },
        "translation": {
          "description": "Translation abbreviation shown to the operator.",
          "type": "string"
        },
        "verses": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumberRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive verse range, when recorded."
        }
      },
      "required": [
        "book",
        "translation"
      ],
      "type": "object"
    },
    "UnavailableReason": {
      "description": "Why a linked presentation could not be summarized.",
      "oneOf": [
        {
          "description": "The item records no usable file location.",
          "properties": {
            "reason": {
              "const": "no_locator",
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The package has no embedded file for the item.",
          "properties": {
            "file_name": {
              "description": "The file name the item links to.",
              "type": "string"
            },
            "reason": {
              "const": "embedded_file_missing",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "file_name"
          ],
          "type": "object"
        },
        {
          "description": "Several embedded files match the item's file name ignoring case.",
          "properties": {
            "candidates": {
              "description": "Every matching archive member.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reason": {
              "const": "embedded_file_ambiguous",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "candidates"
          ],
          "type": "object"
        },
        {
          "description": "The linked library file does not exist.",
          "properties": {
            "path": {
              "description": "Where the file was expected, relative to the data root when known.",
              "type": "string"
            },
            "reason": {
              "const": "file_missing",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "The linked file resolves outside the data root and was not read.",
          "properties": {
            "path": {
              "description": "The resolved location.",
              "type": "string"
            },
            "reason": {
              "const": "file_outside_root",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "The file exists but could not be read.",
          "properties": {
            "detail": {
              "description": "Operating-system error text.",
              "type": "string"
            },
            "reason": {
              "const": "unreadable",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "detail"
          ],
          "type": "object"
        },
        {
          "description": "The file was read but is not a native `ProPresenter` presentation.",
          "properties": {
            "detail": {
              "description": "Decoder error text.",
              "type": "string"

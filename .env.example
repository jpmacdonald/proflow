# Planning Center API credentials
PCO_APP_ID=your_pco_app_id
PCO_SECRET=your_pco_secret

# Active ProPresenter show root. On macOS this may be omitted when
# ProPresenter's applicationShowDirectory preference is authoritative.
PROPRESENTER_DIR=~/Documents/ProPresenter
# The registered presentation library name belongs in proflow.config.json.
# Optional workstation output/display overrides derive from the show root.
# THEMES_DIR=~/Documents/ProPresenter/Themes
# PLAYLIST_DIR=~/Documents/ProPresenter/Playlists/ProFlow

# Portable church policy/data bundle. Repository development defaults to ./data.
# PROFLOW_DATA=/absolute/path/to/proflow-data

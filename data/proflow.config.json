{
  "version": 2,
  "metadata": {
    "name": "VPC",
    "timezone": "America/New_York",
    "notes": "MCP-first service build config"
  },
  "defaults": {
    "theme": "VPC Theme",
    "review_policy": "ask"
  },
  "service_groups": {
    "primary": {
      "service_types": [
        "9:00am contemporary",
        "10:30am traditional"
      ]
    },
    "seasonal": {
      "service_types": [
        "Christmas Eve"
      ]
    }
  },
  "profiles": {
    "weekly": {
      "description": "Primary weekly services",
      "service_groups": [
        "primary"
      ],
      "review_policy": "ask"
    },
    "seasonal": {
      "description": "Seasonal services",
      "service_groups": [
        "seasonal"
      ],
      "days_ahead": 60,
      "review_policy": "ask"
    }
  },
  "presentation_types": {
    "pre_post_service": {
      "kind": "graphic",
      "content_source": "static",
      "output_strategy": "use_existing",
      "macro": "Graphics",
      "description": "Static pre/post service slides"
    },
    "person_nametag": {
      "kind": "nametag",
      "content_source": "static",
      "output_strategy": "use_existing",
      "template": "Name Tag",
      "macro": "Name Tag/Title",
      "description": "Static speaker nametag"
    },
    "content_nametag": {
      "kind": "nametag",
      "content_source": "description",
      "output_strategy": "edit_in_place",
      "template": "Information (Projectors)",
      "background": "default",
      "macro": "Name Tag/Title",
      "description": "Nametag-style slide with weekly content"
    },
    "announcements": {
      "kind": "announcement",
      "content_source": "static",
      "output_strategy": "use_existing",
      "macro": "Graphics",
      "description": "Announcements slides updated separately"
    },
    "song": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "use_existing",
      "template": "Lyrics (Projectors)",
      "macro": "Song",
      "arrangement": "Default",
      "description": "Song or hymn from library"
    },
    "liturgical_static": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "use_existing",
      "template": "Information (Projectors)",
      "macro": "Scripture/Prayer",
      "description": "Reusable liturgical text"
    },
    "liturgical_edited": {
      "kind": "liturgy",
      "content_source": "description",
      "output_strategy": "edit_in_place",
      "template": "Scripture (Projectors) (Responsive)",
      "background": "default",
      "macro": "Scripture/Prayer",
      "description": "Liturgical text regenerated from description"
    },
    "scripture": {
      "kind": "scripture",
      "content_source": "scripture",
      "output_strategy": "generate_new",
      "template": "Scripture (Projectors)",
      "title_template": "Information (Projectors)",
      "background": "default",
      "macro": "Name Tag/Title",
      "content_macro": "Scripture/Prayer",
      "description": "Scripture slides generated from Bible data"
    },
    "final_slide": {
      "kind": "graphic",
      "content_source": "static",
      "output_strategy": "use_existing",
      "macro": "Graphics",
      "description": "End-of-service reflection slide"
    }
  },
  "people": {
    "Hope": {
      "last": "Lee",
      "role": "pastor",
      "nametag": "Hope Nametag"
    },
    "Robert": {
      "last": "Austell",
      "role": "pastor",
      "nametag": "Robert Nametag"
    },
    "Connie": {
      "last": "Jordan-Haas",
      "role": "pastor",
      "nametag": "Connie Nametag"
    },
    "Marilyn": {
      "last": "Shenenberger",
      "role": "organist",
      "nametag": "Marilyn Nametag"
    }
  },
  "item_rules": [
    {
      "id": "skip_benediction",
      "match": {
        "title_prefix": [
          "benediction"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Benediction - skip"
      }
    },
    {
      "id": "skip_sermon",
      "match": {
        "title_prefix": [
          "sermon"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Sermon - skip (added day-of)"
      }
    },
    {
      "id": "all_songs",
      "match": {
        "category": "song"
      },
      "use_type": "song"
    },
    {
      "id": "scripture",
      "match": {
        "title_prefix": [
          "scripture"
        ],
        "has_scripture_ref": true
      },
      "use_type": "scripture"
    },
    {
      "id": "pre_post_service",
      "match": {
        "title_prefix": [
          "pre-service",
          "pre-service slides",
          "service"
        ]
      },
      "use_type": "pre_post_service",
      "target": {
        "library_file": "Pre-Service, Post-Service Slides.pro"
      }
    },
    {
      "id": "post_service",
      "match": {
        "title_prefix": [
          "post-service"
        ]
      },
      "use_type": "final_slide",
      "target": {
        "library_file": "Final Slide - sermon reflection, prayer.pro"
      }
    },
    {
      "id": "greeting_one_another",
      "match": {
        "title_prefix": [
          "greeting one another"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Greeting.pro"
      }
    },
    {
      "id": "gloria_patri",
      "match": {
        "title_prefix": [
          "gloria patri",
          "#579 gloria patri"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Gloria Patri.pro"
      }
    },
    {
      "id": "apostles_creed",
      "match": {
        "title_prefix": [
          "apostles' creed",
          "apostles creed"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Apostles' Creed.pro"
      }
    },
    {
      "id": "doxology",
      "match": {
        "title_prefix": [
          "doxology and prayer of dedication"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Doxology and Prayer of Dedication.pro"
      }
    },
    {
      "id": "offertory_nametag",
      "match": {
        "title_prefix": [
          "giving of tithes and offerings"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Offertory Nametag.pro"
      }
    },
    {
      "id": "lords_prayer",
      "match": {
        "title_prefix": [
          "prayer and the lord's prayer",
          "prayer and lord's prayer"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Prayer and The Lord's Prayer.pro"
      }
    },
    {
      "id": "call_to_worship",
      "match": {
        "title_prefix": [
          "call to worship"
        ]
      },
      "use_type": "liturgical_edited",
      "target": {
        "library_file": "Call to Worship.pro"
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "liturgical_edited"
        }
      ]
    },
    {
      "id": "prayer_of_confession",
      "match": {
        "title_prefix": [
          "prayer of confession"
        ]
      },
      "use_type": "liturgical_edited",
      "target": {
        "library_file": "Prayer of Confession.pro"
      }
    },
    {
      "id": "affirmation_of_faith",
      "match": {
        "title_prefix": [
          "affirmation of faith"
        ]
      },
      "use_type": "liturgical_edited"
    },
    {
      "id": "responsive_reading",
      "match": {
        "title_prefix": [
          "responsive reading"
        ]
      },
      "use_type": "liturgical_edited"
    },
    {
      "id": "litany",
      "match": {
        "title_prefix": [
          "litany"
        ]
      },
      "use_type": "liturgical_edited"
    },
    {
      "id": "unison_prayer",
      "match": {
        "title_prefix": [
          "unison prayer"
        ]
      },
      "use_type": "liturgical_edited"
    },
    {
      "id": "childrens_message",
      "match": {
        "title_prefix": [
          "children's message"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Children's Message Nametag.pro"
      }
    },
    {
      "id": "moment_for_mission",
      "match": {
        "title_prefix": [
          "moment for mission"
        ]
      },
      "use_type": "content_nametag"
    },
    {
      "id": "organ_prelude",
      "match": {
        "title_prefix": [
          "organ prelude"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Prelude Nametag.pro"
      }
    },
    {
      "id": "organ_postlude",
      "match": {
        "title_prefix": [
          "organ postlude"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Postlude Nametag.pro"
      }
    },
    {
      "id": "welcome_bundle",
      "match": {
        "title_prefix": [
          "welcome"
        ]
      },
      "use_type": "announcements",
      "target": {
        "library_file": "Announcements.pro"
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "announcements",
          "target": {
            "library_file": "Announcements.pro"
          }
        }
      ]
    }
  ],
  "overrides": []
}

    {
      "id": "call_to_worship",
      "match": {
        "title_prefix": [
          "call to worship"
        ]
      },
      "expand": [
        {
          "use_type": "title_static",
          "speaker": "resolved"
        },
        {
          "use_type": "liturgical_edited",
          "target": {
            "library_file": "Call to Worship.pro"
          }
        }
      ]
    },
    {
      "id": "skip_confession_explicitly_marked_no_slide",

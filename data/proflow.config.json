{
  "version": 4,
  "metadata": {
    "name": "VPC",
    "timezone": "America/New_York",
    "notes": "MCP-first service build config"
  },
  "defaults": {
    "theme": "VPC Theme",
    "background": "default",
    "bible_version": "NRSVue",
    "presentation_size": {
      "width": 1920,
      "height": 1080
    }
  },
  "backgrounds": {
    "default": "backgrounds/default.png"
  },
  "service_groups": {
    "primary": {
      "service_types": [
        "9:00am contemporary",
        "10:30am traditional"
      ]
    },
    "seasonal": {
      "service_types": [
        "Christmas Eve"
      ]
    }
  },
  "required_playlist_items": [
    {
      "id": "pre_post_service",
      "use_type": "static_graphic",
      "library_file": "Pre-Service, Post-Service Slides.pro",
      "placement": "start",
      "service_group": "primary"
    },
    {
      "id": "stephen_minister",
      "use_type": "static_graphic",
      "library_file": "Stephen Minister Slide.pro",
      "placement": "end",
      "service_group": "primary"
    }
  ],
  "cue_roles": {
    "title": {
      "slide": "Information (Projectors)",
      "enter_macro": "Name Tag/Title"
    },
    "scripture_prayer": {
      "slide": "Scripture (Projectors)",
      "enter_macro": "Scripture/Prayer"
    },
    "responsive_scripture_prayer": {
      "slide": "Scripture (Projectors) (Responsive)",
      "enter_macro": "Scripture/Prayer",
      "all_content_colored_macro": "Scripture/Prayer (Highlighted)"
    }
  },
  "presentation_types": {
    "static_graphic": {
      "kind": "graphic",
      "content_source": "static",
      "output_strategy": "use_existing",
      "description": "Reusable graphic presentation"
    },
    "person_nametag": {
      "kind": "nametag",
      "content_source": "static",
      "output_strategy": "use_existing",
      "description": "Static speaker nametag"
    },
    "content_nametag": {
      "kind": "nametag",
      "content_source": "description",
      "description_parser": "content_nametag",
      "output_strategy": "edit_in_place",
      "display": {
        "kind": "single",
        "role": "title"
      },
      "max_lines_per_slide": 4,
      "description": "Nametag-style slide with weekly content"
    },
    "song": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "use_existing",
      "description": "Song or hymn from library; uses the Planning Center arrangement when supplied"
    },
    "liturgical_static": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "use_existing",
      "description": "Reusable liturgical text"
    },
    "doxology_with_prayer": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "use_existing",
      "arrangement": "& Prayer of Dedication",
      "description": "Doxology followed by the Prayer of Dedication"
    },
    "liturgical_edited": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical",
      "output_strategy": "edit_in_place",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "responsive_scripture_prayer"
      },
      "max_lines_per_slide": 8,
      "description": "Liturgical text regenerated from description"
    },
    "liturgical_generated": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical",
      "output_strategy": "generate_new",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "responsive_scripture_prayer"
      },
      "max_lines_per_slide": 8,
      "description": "One-off liturgical text generated from weekly description"
    },
    "scripture": {
      "kind": "scripture",
      "content_source": "scripture",
      "output_strategy": "generate_new",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "scripture_prayer"
      },
      "description": "Scripture slides generated from Bible data"
    }
  },
  "people": {
    "Hope": {
      "last": "Lee",
      "role": "pastor",
      "nametag": "Hope Nametag"
    },
    "Robert": {
      "last": "Austell",
      "role": "pastor",
      "nametag": "Robert Nametag"
    },
    "Connie": {
      "last": "Jordan-Haas",
      "role": "pastor",
      "nametag": "Connie Nametag"
    },
    "Marilyn": {
      "last": "Shenenberger",
      "role": "organist",
      "nametag": "Marilyn Nametag"
    }
  },
  "item_rules": [
    {
      "id": "sermon_manual_only",
      "match": {
        "title_prefix": [
          "sermon"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Sermon slides are added manually after ProFlow builds"
      }
    },
    {
      "id": "skip_benediction",
      "match": {
        "title_prefix": [
          "benediction"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Benediction - skip"
      }
    },
    {
      "id": "youth_choir_psalm_23_surely_goodness",
      "match": {
        "title_contains": [
          "psalm 23 surely goodness"
        ]
      },
      "use_type": "song",
      "target": {
        "library_file": "Psalm 23 (Surely Goodness).pro"
      }
    },
    {
      "id": "choir_anthem",
      "match": {
        "title_prefix": [
          "choir anthem:",
          "anthem:"
        ]
      },
      "use_type": "song"
    },
    {
      "id": "hymn_356_come_thou_fount",
      "match": {
        "title_prefix": [
          "#356 come, thou fount of every blessing"
        ]
      },
      "use_type": "song",
      "target": {
        "library_file": "[Hymn] Come, Thou Fount of Every Blessing.pro"
      }
    },
    {
      "id": "all_songs",
      "match": {
        "category": "song"
      },
      "use_type": "song"
    },
    {
      "id": "scripture",
      "match": {
        "title_prefix": [
          "scripture"
        ]
      },
      "use_type": "scripture"
    },
    {
      "id": "skip_section_header",
      "match": {
        "title_prefix": [
          "pre-service",
          "service"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "PCO section header - not a slide"
      }
    },
    {
      "id": "post_service",
      "match": {
        "title_prefix": [
          "post-service"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Post-service final slide no longer used"
      }
    },
    {
      "id": "greeting_one_another",
      "match": {
        "title_prefix": [
          "greeting",
          "greeting one another"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Greeting.pro"
      }
    },
    {
      "id": "baptism_contextual",
      "match": {
        "title_prefix": [
          "baptism"
        ]
      },
      "decision": {
        "kind": "choose_existing_file",
        "context_fields": [
          "title",
          "description",
          "note"
        ],
        "instructions": "Choose based on who is being baptized. Use Him for a boy/son/he/him, Her for a girl/daughter/she/her, Them for multiple baptism candidates. Ask if unclear.",
        "on_ambiguous": "ask",
        "choices": {
          "him": {
            "use_type": "liturgical_static",
            "file": "Baptism Him.pro",
            "match": {
              "any": [
                "son of",
                " he ",
                " him ",
                " his ",
                " boy "
              ],
              "none": [
                "daughter of",
                "daughters of",
                "children of",
                "sons of"
              ]
            }
          },
          "her": {
            "use_type": "liturgical_static",
            "file": "Baptism Her.pro",
            "match": {
              "any": [
                "daughter of",
                " she ",
                " her ",
                " girl "
              ],
              "none": [
                "son of",
                "sons of",
                "children of",
                "daughters of"
              ]
            }
          },
          "them": {
            "use_type": "liturgical_static",
            "file": "Baptism Them.pro",
            "match": {
              "any": [
                "children of",
                "sons of",
                "daughters of",
                "twins",
                "multiple baptisms"
              ]
            }
          }
        }
      }
    },
    {
      "id": "gloria_patri",
      "match": {
        "title_prefix": [
          "gloria patri",
          "#579 gloria patri"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Gloria Patri.pro"
      }
    },
    {
      "id": "heidelberg_confession_q1",
      "match": {
        "title_prefix": [
          "heidelberg confession, q1",
          "heidelberg confession q1"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Heidleberg Chatechism - Question 1.pro"
      }
    },
    {
      "id": "apostles_creed",
      "match": {
        "title_contains": [
          "apostles' creed",
          "apostles creed"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "Apostles Creed.pro"
      }
    },
    {
      "id": "doxology",
      "match": {
        "title_prefix": [
          "doxology and prayer of dedication",
          "doxology/prayer of dedication",
          "doxology / prayer of dedication"
        ]
      },
      "use_type": "doxology_with_prayer",
      "target": {
        "library_file": "Doxology and Prayer of Dedication.pro"
      }
    },
    {
      "id": "offertory_nametag",
      "match": {
        "title_prefix": [
          "giving of tithes and offerings"
        ]
      },
      "use_type": "static_graphic",
      "target": {
        "library_file": "Offertory Nametag.pro"
      }
    },
    {
      "id": "offertory_o_depth_tunny",
      "match": {
        "title_prefix": [
          "offertory: o, the depth of the love of god"
        ]
      },
      "use_type": "song",
      "target": {
        "library_file": "O, The Depth of the Love of God - Tunny.pro"
      }
    },
    {
      "id": "offertory_detail_music",
      "match": {
        "title_prefix": [
          "offertory:"
        ]
      },
      "use_type": "song"
    },
    {
      "id": "lords_prayer",
      "match": {
        "title_prefix": [
          "prayer and the lord's prayer",
          "prayer and lord's prayer"
        ]
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "liturgical_static",
          "target": {
            "library_file": "Prayer and The Lord's Prayer.pro"
          }
        }
      ]
    },
    {
      "id": "call_to_worship",
      "match": {
        "title_prefix": [
          "call to worship"
        ]
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "liturgical_edited",
          "target": {
            "library_file": "Call to Worship.pro"
          }
        }
      ]
    },
    {
      "id": "prayer_of_confession",
      "match": {
        "title_prefix": [
          "prayer of confession"
        ]
      },
      "use_type": "liturgical_edited",
      "target": {
        "library_file": "Prayer of Confession.pro"
      }
    },
    {
      "id": "affirmation_of_faith",
      "match": {
        "title_prefix": [
          "affirmation of faith"
        ]
      },
      "use_type": "liturgical_generated"
    },
    {
      "id": "responsive_reading",
      "match": {
        "title_prefix": [
          "responsive reading"
        ]
      },
      "use_type": "liturgical_generated"
    },
    {
      "id": "litany",
      "match": {
        "title_prefix": [
          "litany"
        ]
      },
      "use_type": "liturgical_generated"
    },
    {
      "id": "unison_prayer",
      "match": {
        "title_prefix": [
          "unison prayer"
        ]
      },
      "use_type": "liturgical_generated"
    },
    {
      "id": "childrens_message",
      "match": {
        "title_prefix": [
          "children's message"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Children's Message Nametag.pro"
      }
    },
    {
      "id": "moment_for_mission",
      "match": {
        "title_prefix": [
          "moment for mission"
        ]
      },
      "use_type": "content_nametag"
    },
    {
      "id": "music_prelude",
      "match": {
        "title_contains": [
          "prelude:"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Prelude Nametag.pro"
      }
    },
    {
      "id": "music_postlude",
      "match": {
        "title_contains": [
          "postlude:"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Postlude Nametag.pro"
      }
    },
    {
      "id": "organ_prelude",
      "match": {
        "title_prefix": [
          "prelude",
          "organ prelude"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Prelude Nametag.pro"
      }
    },
    {
      "id": "organ_postlude",
      "match": {
        "title_prefix": [
          "postlude",
          "organ postlude"
        ]
      },
      "use_type": "content_nametag",
      "target": {
        "library_file": "Postlude Nametag.pro"
      }
    },
    {
      "id": "new_member_recognition",
      "match": {
        "title_prefix": [
          "welcome of new members"
        ]
      },
      "use_type": "liturgical_static",
      "target": {
        "library_file": "New Member Recognition.pro"
      }
    },
    {
      "id": "welcome_bundle",
      "match": {
        "title_prefix": [
          "welcome"
        ]
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "static_graphic",
          "target": {
            "library_file": "Announcements.pro"
          }
        }
      ]
    }
  ],
  "overrides": []
}

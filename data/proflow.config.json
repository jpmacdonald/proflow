{
  "version": 4,
  "metadata": {
    "name": "VPC",
    "timezone": "America/New_York",
    "notes": "MCP-first service build config"
  },
  "defaults": {
    "library": "Default",
    "theme": "VPC Theme",
    "background": "default",
    "bible_version": "NRSVue",
    "speaker_fallback_rule": "lords_prayer",
    "presentation_size": {
      "width": 1920,
      "height": 1080
    }
  },
  "backgrounds": {
    "default": "backgrounds/default.png",
    "sermon": "backgrounds/sermon.png"
  },
  "service_groups": {
    "primary": {
      "service_types": [
        "9:00am contemporary",
        "10:30am traditional"
      ]
    }
  },
  "required_playlist_items": [
    {
      "id": "pre_post_service",
      "use_type": "static_graphic",
      "library_file": "Pre-Service, Post-Service Slides.pro",
      "placement": "start",
      "service_group": "primary"
    },
    {
      "id": "stephen_minister",
      "use_type": "static_graphic",
      "library_file": "Stephen Minister Slide.pro",
      "placement": "end",
      "service_group": "primary"
    }
  ],
  "cue_roles": {
    "title": {
      "slide": "Information (Projectors)",
      "text_slots": {
        "body": "Text"
      },
      "enter_macro": "Name Tag/Title"
    },
    "scripture_prayer": {
      "slide": "Scripture (Projectors)",
      "text_slots": {
        "body": "Scripture"
      },
      "enter_macro": "Scripture/Prayer"
    },
    "responsive_scripture_prayer": {
      "slide": "Scripture (Projectors) (Responsive)",
      "text_slots": {
        "body": "Scripture"
      },
      "enter_macro": "Scripture/Prayer",
      "leader_enter_macro": "Scripture/Prayer (Highlighted)",
      "speaker_colors": {
        "leader": "#FEDB4F",
        "audience": "#FFFFFF"
      }
    }
  },
  "presentation_types": {
    "static_graphic": {
      "kind": "graphic",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "macro_transitions": {
        "regions": [
          {
            "selector": { "kind": "operator_cue", "index": 0 },
            "enter_macro": "Graphics"
          }
        ]
      },
      "description": "Graphic presentation: preserve native media/backgrounds and enforce Graphics on entry"
    },
    "communion_graphic_static": {
      "kind": "graphic",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "arrangement": "Simple",
      "macro_transitions": {
        "regions": [
          {
            "selector": {
              "kind": "operator_cue",
              "index": 0
            },
            "enter_macro": "Graphics"
          }
        ]
      },
      "description": "One-slide Communion graphic selected from the native Simple arrangement"
    },
    "content_nametag": {
      "kind": "nametag",
      "content_source": "description",
      "description_parser": "content_nametag",
      "output_strategy": "edit_in_place",
      "display": {
        "kind": "single",
        "role": "title"
      },
      "max_lines_per_slide": 4,
      "description": "Nametag-style slide with weekly content"
    },
    "generated_content_nametag": {
      "kind": "nametag",
      "content_source": "description",
      "description_parser": "content_nametag",
      "output_strategy": "generate_new",
      "display": {
        "kind": "single",
        "role": "title"
      },
      "max_lines_per_slide": 4,
      "description": "One-off nametag-style slide generated from weekly content"
    },
    "song": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "restyle_existing",
      "background": "default",
      "macro_transitions": {
        "regions": [
          {
            "selector": {
              "kind": "arrangement_group",
              "index": 0,
              "names": ["Background", "Blank", "Title"]
            },
            "enter_macro": "Song"
          }
        ]
      },
      "description": "Contemporary song: the native empty entry (commonly named Background, Blank, or Title) runs Song; native lyrics and arrangement remain intact"
    },
    "hymn": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "restyle_existing",
      "background": "default",
      "macro_transitions": {
        "regions": [
          {
            "selector": {
              "kind": "arrangement_group",
              "index": 0,
              "names": ["Background", "Title"]
            },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": {
              "kind": "arrangement_group",
              "index": 1,
              "names": ["Verse", "Verse 1"]
            },
            "enter_macro": "Song"
          }
        ]
      },
      "description": "Hymn: title entry runs Name Tag/Title, then the first verse entry transitions to Song"
    },
    "title_static": {
      "kind": "nametag",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "operator_cue_limit": 1,
      "macro_transitions": {
        "regions": [
          {
            "selector": { "kind": "operator_cue", "index": 0 },
            "enter_macro": "Name Tag/Title"
          }
        ]
      },
      "description": "Single native title cue with the managed background"
    },
    "multi_nametag_static": {
      "kind": "nametag",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "description": "Native multi-slide nametag presentation with existing title macro transitions preserved"
    },
    "leader_liturgy_static": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "macro_transitions": {
        "regions": [
          {
            "selector": { "kind": "operator_cue", "index": 0 },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": { "kind": "operator_cue", "index": 1 },
            "enter_macro": "Scripture/Prayer (Highlighted)"
          }
        ]
      },
      "description": "Native leader-read liturgy: title then highlighted text"
    },
    "audience_liturgy_static": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "macro_transitions": {
        "regions": [
          {
            "selector": { "kind": "operator_cue", "index": 0 },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": { "kind": "operator_cue", "index": 1 },
            "enter_macro": "Scripture/Prayer"
          }
        ]
      },
      "description": "Native audience-read liturgy: title then ordinary Scripture/Prayer"
    },
    "preserved_liturgy_static": {
      "kind": "liturgy",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "description": "Native liturgy with managed background and its existing semantic macro transitions preserved"
    },
    "titled_song_static": {
      "kind": "song",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "macro_transitions": {
        "regions": [
          {
            "selector": { "kind": "operator_cue", "index": 0 },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": { "kind": "operator_cue", "index": 1 },
            "enter_macro": "Song"
          }
        ]
      },
      "description": "Arrangementless native song with a title cue followed by lyrics"
    },
    "titled_anthem_static": {
      "kind": "song",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "arrangement": "[Anthem]",
      "macro_transitions": {
        "regions": [
          {
            "selector": {
              "kind": "operator_cue",
              "index": 0
            },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": {
              "kind": "operator_cue",
              "index": 1
            },
            "enter_macro": "Song"
          }
        ]
      },
      "description": "Native anthem arrangement with a title cue followed by lyrics"
    },
    "doxology_with_prayer": {
      "kind": "song",
      "content_source": "static",
      "output_strategy": "restyle_existing",
      "background": "default",
      "arrangement": "& Prayer of Dedication",
      "macro_transitions": {
        "regions": [
          {
            "selector": {
              "kind": "arrangement_group",
              "index": 0,
              "names": ["Group"]
            },
            "enter_macro": "Name Tag/Title"
          },
          {
            "selector": {
              "kind": "arrangement_group",
              "index": 1,
              "names": ["Verse"]
            },
            "enter_macro": "Song"
          }
        ]
      },
      "description": "Doxology title and lyrics from the native '& Prayer of Dedication' arrangement; prayer text is intentionally not displayed"
    },
    "liturgical_edited": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical",
      "output_strategy": "edit_in_place",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "responsive_scripture_prayer"
      },
      "max_lines_per_slide": 8,
      "description": "Liturgical text regenerated from description"
    },
    "liturgical_generated": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical",
      "output_strategy": "generate_new",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "responsive_scripture_prayer"
      },
      "max_lines_per_slide": 8,
      "description": "One-off liturgical text generated from weekly description"
    },
    "liturgical_audience_generated": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical_audience",
      "output_strategy": "generate_new",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "responsive_scripture_prayer"
      },
      "max_lines_per_slide": 8,
      "description": "Audience-read liturgy generated from weekly description"
    },
    "scripture": {
      "kind": "scripture",
      "content_source": "scripture",
      "output_strategy": "generate_new",
      "display": {
        "kind": "split",
        "title": "title",
        "content": "scripture_prayer"
      },
      "max_lines_per_slide": 7,
      "description": "Scripture slides generated from Bible data"
    },
    "sermon_title": {
      "kind": "nametag",
      "content_source": "description",
      "description_parser": "content_nametag",
      "output_strategy": "generate_new",
      "display": {
        "kind": "single",
        "role": "title"
      },
      "background": "sermon",
      "max_lines_per_slide": 4,
      "description": "Sermon title generated from the Planning Center item title"
    }
  },
  "people": {
    "Hope": {
      "last": "Lee",
      "role": "pastor",
      "nametag": "Hope Nametag"
    },
    "Robert": {
      "last": "Austell",
      "role": "pastor",
      "nametag": "Robert Nametag"
    },
    "Connie": {
      "last": "Jordan-Haas",
      "role": "pastor",
      "nametag": "Connie Nametag"
    },
    "Marilyn": {
      "last": "Shenenberger",
      "role": "organist",
      "nametag": "Marilyn Nametag"
    },
    "Adrian": {
      "last": "Rogers",
      "role": "pastor",
      "nametag": "Adrian Nametag"
    }
  },
  "item_rules": [
    {
      "id": "sermon_title",
      "match": {
        "title_prefix": [
          "sermon"
        ]
      },
      "use_type": "sermon_title"
    },
    {
      "id": "skip_benediction",
      "match": {
        "title_prefix": [
          "benediction"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Benediction - skip"
      }
    },
    {
      "id": "youth_choir_psalm_23_surely_goodness",
      "match": {
        "title_contains": [
          "psalm 23 surely goodness"
        ]
      },
      "use_type": "song",
      "target": {
        "library_file": "Psalm 23 (Surely Goodness).pro"
      }
    },
    {
      "id": "choir_anthem",
      "match": {
        "title_prefix": [
          "choir anthem:",
          "anthem:"
        ]
      },
      "use_type": "song"
    },
    {
      "id": "hymn_356_come_thou_fount",
      "match": {
        "title_prefix": [
          "#356 come, thou fount of every blessing"
        ]
      },
      "use_type": "titled_song_static",
      "target": {
        "library_file": "[Hymn] Come, Thou Fount of Every Blessing.pro"
      }
    },
    {
      "id": "hymn_361_how_firm_a_foundation",
      "match": {
        "title_prefix": [
          "#361 how firm a foundation"
        ]
      },
      "use_type": "hymn",
      "target": {
        "library_file": "[Hymn] How Firm A Foundation.pro"
      }
    },
    {
      "id": "hymn_384_o_love_that_wilt_not_let_me_go",
      "match": {
        "title_prefix": [
          "#384 o love that wilt not let me go"
        ]
      },
      "use_type": "titled_song_static",
      "target": {
        "library_file": "[Hymn] O Love That Wilt Not Let Me Go.pro"
      }
    },
    {
      "id": "hymn_428_i_need_thee_every_hour_hwc",
      "match": {
        "title_prefix": [
          "hwc #428 i need thee every hour"
        ]
      },
      "use_type": "hymn",
      "target": {
        "library_file": "[Hymn] I Need Thee Every Hour (HWC).pro"
      }
    },
    {
      "id": "hymn_840_it_is_well_with_my_soul",
      "match": {
        "title_contains": [
          "#840 it is well with my soul"
        ]
      },
      "use_type": "hymn",
      "target": {
        "library_file": "[Hymn] It Is Well With My Soul.pro"
      }
    },
    {
      "id": "scripture",
      "match": {
        "title_prefix": [
          "scripture"
        ]
      },
      "use_type": "scripture"
    },
    {
      "id": "skip_section_header",
      "match": {
        "title_prefix": [
          "pre-service",
          "service"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "PCO section header - not a slide"
      }
    },
    {
      "id": "mad_camp_title",
      "match": {
        "title_prefix": [
          "mad camp"
        ]
      },
      "use_type": "generated_content_nametag"
    },
    {
      "id": "skip_invitation_to_worship",
      "match": {
        "title_prefix": [
          "[invitation to worship]",
          "invitation to worship"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Spoken invitation to worship - no slide"
      }
    },
    {
      "id": "skip_invitation_to_prepare",
      "match": {
        "title_prefix": [
          "[invitation to prepare for worship",
          "invitation to prepare for worship"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Spoken invitation to prepare for worship - no slide"
      }
    },
    {
      "id": "post_service",
      "match": {
        "title_prefix": [
          "post-service"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Post-service final slide no longer used"
      }
    },
    {
      "id": "greeting_one_another",
      "match": {
        "title_prefix": [
          "greeting"
        ]
      },
      "use_type": "title_static",
      "target": {
        "library_file": "Greeting.pro"
      }
    },
    {
      "id": "nextgen_summer_missions_commissioning",
      "match": {
        "title_prefix": [
          "commissioning of nextgen summer missions"
        ]
      },
      "use_type": "preserved_liturgy_static",
      "target": {
        "library_file": "Commissioning of NextGen Summer Missions.pro"
      }
    },
    {
      "id": "baptism_contextual",
      "match": {
        "title_prefix": [
          "baptism"
        ]
      },
      "decision": {
        "kind": "choose_existing_file",
        "context_fields": [
          "title",
          "description",
          "note"
        ],
        "instructions": "Choose based on who is being baptized. Use Him for a boy/son/he/him, Her for a girl/daughter/she/her, Them for multiple baptism candidates. Ask if unclear.",
        "on_ambiguous": "ask",
        "choices": {
          "him": {
            "use_type": "preserved_liturgy_static",
            "file": "Baptism Him.pro",
            "match": {
              "any": [
                "son of",
                " he ",
                " him ",
                " his ",
                " boy "
              ],
              "none": [
                "daughter of",
                "daughters of",
                "children of",
                "sons of"
              ]
            }
          },
          "her": {
            "use_type": "preserved_liturgy_static",
            "file": "Baptism Her.pro",
            "match": {
              "any": [
                "daughter of",
                " she ",
                " her ",
                " girl "
              ],
              "none": [
                "son of",
                "sons of",
                "children of",
                "daughters of"
              ]
            }
          },
          "them": {
            "use_type": "preserved_liturgy_static",
            "file": "Baptism Them.pro",
            "match": {
              "any": [
                "children of",
                "sons of",
                "daughters of",
                "twins",
                "multiple baptisms"
              ]
            }
          }
        }
      }
    },
    {
      "id": "communion_contemporary",
      "match": {
        "title_prefix": [
          "communion"
        ],
        "service_type": [
          "9:00am contemporary"
        ]
      },
      "use_type": "communion_graphic_static",
      "target": {
        "library_file": "Communion.pro"
      }
    },
    {
      "id": "communion_traditional",
      "match": {
        "title_prefix": [
          "communion"
        ],
        "service_type": [
          "10:30am traditional"
        ]
      },
      "use_type": "liturgical_generated"
    },
    {
      "id": "gloria_patri",
      "match": {
        "title_prefix": [
          "gloria patri",
          "#579 gloria patri"
        ]
      },
      "use_type": "titled_song_static",
      "target": {
        "library_file": "Gloria Patri.pro"
      }
    },
    {
      "id": "nineveh_titled_song",
      "match": {
        "title_prefix": [
          "nineveh"
        ]
      },
      "use_type": "titled_song_static",
      "target": {
        "library_file": "Nineveh (Ligertwood).pro"
      }
    },
    {
      "id": "heidelberg_confession_q1",
      "match": {
        "title_prefix": [
          "heidelberg confession, q1",
          "heidelberg confession q1"
        ]
      },
      "use_type": "preserved_liturgy_static",
      "target": {
        "library_file": "Heidleberg Chatechism - Question 1.pro"
      }
    },
    {
      "id": "apostles_creed",
      "match": {
        "title_contains": [
          "apostles' creed",
          "apostles creed"
        ]
      },
      "use_type": "audience_liturgy_static",
      "target": {
        "library_file": "Apostles Creed.pro"
      }
    },
    {
      "id": "doxology",
      "match": {
        "title_prefix": [
          "doxology and prayer of dedication",

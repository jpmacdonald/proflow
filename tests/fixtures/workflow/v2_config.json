{
  "version": 2,
  "metadata": {
    "name": "Fixture Church",
    "timezone": "America/New_York"
  },
  "defaults": {
    "theme": "Moss",
    "days_ahead": 14,
    "review_policy": "ask"
  },
  "service_groups": {
    "weekly": {
      "service_types": [
        "Sunday Morning"
      ]
    }
  },
  "profiles": {
    "weekly": {
      "description": "Weekly default service build",
      "service_groups": [
        "weekly"
      ],
      "days_ahead": 14,
      "review_policy": "ask"
    }
  },
  "presentation_types": {
    "liturgical_edited": {
      "kind": "liturgy",
      "content_source": "description",
      "output_strategy": "edit_in_place",
      "template": "Call to Worship",
      "background": "default",
      "arrangement": "Standard"
    },
    "song": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "use_existing",
      "template": "Song",
      "background": "default"
    },
    "scripture": {
      "kind": "scripture",
      "content_source": "scripture",
      "output_strategy": "generate_new",
      "template": "Scripture",
      "background": "sermon",
      "macro": "Scripture/Prayer"
    }
  },
  "item_rules": [
    {
      "id": "call_to_worship",
      "match": {
        "title_prefix": [
          "Call to Worship"
        ]
      },
      "use_type": "liturgical_edited",
      "target": {
        "library_file": "Call to Worship.pro"
      }
    },
    {
      "id": "song_amazing_grace",
      "match": {
        "title_prefix": [
          "Amazing Grace"
        ]
      },
      "use_type": "song",
      "target": {
        "library_file": "Amazing Grace.pro"
      }
    },
    {
      "id": "scripture",
      "match": {
        "title_prefix": [
          "Scripture"
        ],
        "has_scripture_ref": true
      },
      "use_type": "scripture"
    },
    {
      "id": "skip_sermon",
      "match": {
        "title_prefix": [
          "Sermon"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Sermon is added day-of"
      }
    }
  ]
}

{
  "version": 4,
  "metadata": {
    "name": "Example Church",
    "timezone": "America/New_York",
    "notes": "Conservative MCP-first starter config"
  },
  "defaults": {
    "days_ahead": 14,
    "presentation_size": {
      "width": 1920,
      "height": 1080
    }
  },
  "service_groups": {
    "weekly_primary": {
      "service_types": [
        "Sunday Morning"
      ]
    },
    "seasonal": {
      "service_types": [
        "Christmas Eve",
        "Ash Wednesday"
      ]
    }
  },
  "presentation_types": {
    "song": {
      "kind": "song",
      "content_source": "song",
      "output_strategy": "preserve_existing",
      "description": "Song or hymn from the library"
    },
    "scripture": {
      "kind": "scripture",
      "content_source": "scripture",
      "output_strategy": "needs_review",
      "description": "Choose project cue roles before enabling scripture generation"
    },
    "liturgy": {
      "kind": "liturgy",
      "content_source": "description",
      "description_parser": "liturgical",
      "output_strategy": "needs_review",
      "description": "Choose an installed theme cue role and target before enabling edit-in-place"
    },
    "person_nametag": {
      "kind": "nametag",
      "content_source": "static",
      "output_strategy": "preserve_existing",
      "description": "Speaker nametag slide"
    }
  },
  "item_rules": [
    {
      "id": "skip_benediction",
      "match": {
        "title_prefix": [
          "benediction"
        ]
      },
      "action": {
        "kind": "skip",
        "reason": "Handled live"
      }
    },
    {
      "id": "all_songs",
      "match": {
        "category": "song"
      },
      "use_type": "song"
    },
    {
      "id": "scripture",
      "match": {
        "title_prefix": [
          "scripture"
        ]
      },
      "use_type": "scripture"
    },
    {
      "id": "call_to_worship",
      "match": {
        "title_prefix": [
          "call to worship"
        ]
      },
      "expand": [
        {
          "use_type": "person_nametag",
          "speaker": "resolved"
        },
        {
          "use_type": "liturgy"
        }
      ],
      "notes": "Example multi-output rule: speaker nametag plus weekly liturgy"
    }
  ],
  "people": {
    "Pastor": {
      "last": "Example",
      "role": "pastor",
      "nametag": "Pastor Nametag"
    }
  },
  "overrides": []
}
